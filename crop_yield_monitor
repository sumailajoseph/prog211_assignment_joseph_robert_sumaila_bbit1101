# Each inner tuple is: (crop code, crop name, expected yield in tonnes per hectare)
CROP_CATALOGUE = (
    ("RICE",  "Rice",         2.5),
    ("CASS",  "Cassava",     10.0),
    ("MAIZE", "Maize",        2.0),
    ("GNUT",  "Groundnut",    1.2),
    ("SWPOT", "Sweet Potato", 6.0),
)

# Growing seasons
SEASONS = ("Rainy", "Dry")

# Yield rating bands: (minimum share of the expected yield, rating)
# e.g. 1.2 means "at least 120% of the expected yield"
YIELD_RATINGS = (
    (1.2, "Excellent"),
    (1.0, "Good"),
    (0.7, "Fair"),
    (0.0, "Poor"),
)

AREA_LIMITS = (0.1, 100.0)   # (smallest, largest) field size in hectares


def get_rating(ratio):
    """Return the rating word for a yield ratio, using the YIELD_RATINGS tuple."""
    for minimum, rating in YIELD_RATINGS:   # tuple unpacking
        if ratio >= minimum:
            return rating
    return "Poor"


