class Crop:
    """A type of crop and the yield a farmer can normally expect."""

    total_crops = 0   # class attribute shared by every Crop object

    def __init__(self, code, name, expected_yield):
        if expected_yield <= 0:
            raise ValueError("Expected yield must be more than 0 tonnes per hectare.")
        self.code = code.upper()
        self.name = name
        self.expected_yield = expected_yield     # tonnes per hectare
        Crop.total_crops += 1

    # ---------- Instance methods ----------
    def display_info(self):
        print(f"  {self.code:<7}{self.name:<15}expected {self.expected_yield:>5.1f} t/ha")

    def get_statistics(self, records):
        """
        Work out statistics for this crop from the records dictionary.
        Returns a TUPLE: (number of harvests, total kg, average t/ha, best record)
        """
        count = 0
        total_kg = 0
        total_yield = 0
        best = None
        for record in records.values():
            if record.crop is not self:
                continue
            count += 1
            total_kg += record.quantity_kg
            total_yield += record.yield_per_hectare()
            if best is None or record.yield_per_hectare() > best.yield_per_hectare():
                best = record
        average = round(total_yield / count, 2) if count else 0.0
        return count, total_kg, average, best

    # ---------- Class methods ----------
    @classmethod
    def from_catalogue(cls, entry):
        """Create a Crop from one tuple in CROP_CATALOGUE."""
        code, name, expected = entry   # tuple unpacking
        return cls(code, name, expected)

    @classmethod
    def get_total_crops(cls):
        return cls.total_crops

    def __str__(self):
        return f"{self.name} ({self.code})"


class Farmer:
    """A farmer whose harvests are monitored (minimal personal data)."""

    total_farmers = 0   # class attribute: how many farmers currently exist

    def __init__(self, farmer_id, first_name, district):
        if not first_name.strip() or not district.strip():
            raise ValueError("First name and district cannot be empty.")
        self.farmer_id = farmer_id.upper()
        self.first_name = first_name.strip()
        self.district = district.strip()
        # Dictionary of this farmer's harvests: {record_id: HarvestRecord}
        self.harvests = {}
        Farmer.total_farmers += 1

    # ---------- Instance methods ----------
    def add_harvest(self, record):
        """Attach a HarvestRecord object to this farmer."""
        self.harvests[record.record_id] = record

    def total_harvest_kg(self):
        total = 0
        for record in self.harvests.values():
            total += record.quantity_kg
        return total

    def average_performance(self):
        """Average yield as a percentage of the expected yield (100 = on target)."""
        if not self.harvests:
            return 0
        total = 0
        for record in self.harvests.values():
            total += record.performance_ratio()
        return round(total / len(self.harvests) * 100)

    def display_info(self):
        print(f"  Farmer ID  : {self.farmer_id}")
        print(f"  First name : {self.first_name}")
        print(f"  District   : {self.district}")
        print(f"  Harvests   : {len(self.harvests)} recorded")

    def display_farm_report(self):
        """Print a full farm report for this farmer."""
        print("=" * 66)
        print("                         FARM YIELD REPORT")
        print("=" * 66)
        self.display_info()
        print("-" * 66)
        print(f"  {'ID':<6}{'Crop':<14}{'Season':<12}{'Area':>6}{'Kg':>8}{'t/ha':>7}  Rating")
        print("-" * 66)
        for record in self.harvests.values():
            season = f"{record.season} {record.year}"
            print(f"  {record.record_id:<6}{record.crop.name:<14}{season:<12}"
                  f"{record.area_ha:>6.1f}{record.quantity_kg:>8}"
                  f"{record.yield_per_hectare():>7.2f}  {record.rating()}")
        print("-" * 66)
        print(f"  Total harvested     : {self.total_harvest_kg()} kg")
        print(f"  Average performance : {self.average_performance()}% of expected yield")
        print("=" * 66)

    # ---------- Class methods ----------
    @classmethod
    def from_string(cls, text):
        """Create a Farmer from text like 'F003, Fatmata, Bombali'."""
        farmer_id, first_name, district = (part.strip() for part in text.split(","))
        return cls(farmer_id, first_name, district)

    @classmethod
    def get_total_farmers(cls):
        return cls.total_farmers

    @classmethod
    def record_removal(cls):
        """Reduce the count when a farmer is deleted."""
        cls.total_farmers -= 1

    # ---------- Static method ----------
    @staticmethod
    def find_top_farmer(farmers):
        """Return the farmer with the highest average performance (or None)."""
        top = None
        for farmer in farmers.values():
            if not farmer.harvests:
                continue
            if top is None or farmer.average_performance() > top.average_performance():
                top = farmer
        return top


class HarvestRecord:
    """One harvest of one crop from one farmer's field in one season."""

    total_records = 0   # how many records currently exist
    next_number = 1     # gives every record a unique ID (never reused)

    def __init__(self, farmer, crop, year, season, area_ha, quantity_kg):
        if not HarvestRecord.is_valid_year(year):
            raise ValueError(f"Year must be from 2000 to {date.today().year}.")
        if not HarvestRecord.is_valid_season(season):
            raise ValueError("Season must be one of: " + ", ".join(SEASONS))
        if not HarvestRecord.is_valid_area(area_ha):
            low, high = AREA_LIMITS
            raise ValueError(f"Field area must be from {low} to {high} hectares.")
        if quantity_kg < 0:
            raise ValueError("Harvest quantity cannot be negative.")
        self.record_id = f"H{HarvestRecord.next_number:03d}"
        HarvestRecord.next_number += 1
        HarvestRecord.total_records += 1
        self.farmer = farmer          # a Farmer OBJECT, not just an ID
        self.crop = crop              # a Crop OBJECT
        self.year = year
        self.season = season.capitalize()
        self.area_ha = area_ha
        self.quantity_kg = quantity_kg
        # Objects interacting: the record registers itself with the farmer
        farmer.add_harvest(self)

    # ---------- Instance methods ----------
    def yield_per_hectare(self):
        """Yield in tonnes per hectare (1 tonne = 1000 kg)."""
        return round(self.quantity_kg / 1000 / self.area_ha, 2)

    def performance_ratio(self):
        """How this yield compares with the crop's expected yield (1.0 = on target)."""
        return self.yield_per_hectare() / self.crop.expected_yield

    def rating(self):
        return get_rating(self.performance_ratio())

    def update_quantity(self, new_kg):
        """Correct the harvested quantity (e.g. after re-weighing)."""
        if new_kg < 0:
            raise ValueError("Harvest quantity cannot be negative.")
        old_kg, old_rating = self.quantity_kg, self.rating()
        self.quantity_kg = new_kg
        print(f"  Updated {self.record_id}: {old_kg} kg ({old_rating}) -> "
              f"{new_kg} kg ({self.rating()})")

    def display_info(self):
        season = f"{self.season} {self.year}"
        print(f"  {self.record_id:<6}{self.farmer.farmer_id:<6}{self.farmer.first_name:<10}"
              f"{self.crop.code:<7}{season:<12}{self.area_ha:>5.1f}{self.quantity_kg:>8}"
              f"{self.yield_per_hectare():>7.2f}  {self.rating()}")

    # ---------- Class methods ----------
    @classmethod
    def from_record(cls, text, farmers, crops):
        """Create a record from text like 'F001, RICE, 2025, Rainy, 2.0, 5600'."""
        farmer_id, code, year, season, area, kg = (part.strip() for part in text.split(","))
        farmer = farmers.get(farmer_id.upper())
        crop = crops.get(code.upper())
        if farmer is None:
            raise ValueError(f"No farmer with ID '{farmer_id}'.")
        if crop is None:
            raise ValueError(f"No crop with code '{code}'.")
        return cls(farmer, crop, int(year), season, float(area), int(kg))

    @classmethod
    def get_total_records(cls):
        return cls.total_records

    @classmethod
    def record_removal(cls, count=1):
        cls.total_records -= count

    # ---------- Static methods ----------
    @staticmethod
    def is_valid_area(area_ha):
        low, high = AREA_LIMITS
        return low <= area_ha <= high

    @staticmethod
    def is_valid_season(season):
        return season.capitalize() in SEASONS

    @staticmethod
    def is_valid_year(year):
        return 2000 <= year <= date.today().year


# ===============================================================
# SECTION 3 - RECORD FUNCTIONS (DICTIONARIES)
# A DICTIONARY is the one data structure used to store multiple
# objects, with the unique ID as the key:
#     farmers = {"F001": <Farmer>, ...}
#     crops   = {"RICE": <Crop>, ...}
#     records = {"H001": <HarvestRecord>, ...}
# Each Farmer also keeps its harvests in a dictionary.
# ===============================================================

def add_record(records, key, item):
    """Add an object to a dictionary (rejects duplicate IDs)."""
    if key in records:
        raise ValueError(f"ID {key} already exists.")
    records[key] = item
    return item


def find_record(records, key, label="record"):
    """Look up an object by its ID, with a friendly error if missing."""
    key = key.strip().upper()
    if key not in records:
        raise ValueError(f"No {label} found with ID '{key}'.")
    return records[key]


def delete_farmer(farmers, records, farmer_id):
    """Remove a farmer AND all of their harvest records. Returns the removed farmer."""
    farmer = find_record(farmers, farmer_id, "farmer")
    for record_id in farmer.harvests:
        del records[record_id]
    HarvestRecord.record_removal(len(farmer.harvests))
    del farmers[farmer.farmer_id]
    Farmer.record_removal()
    return farmer


def search_farmers(farmers, text):
    """Print farmers whose first name or district contains the text. Returns the count."""
    text = text.lower()
    found = 0
    for farmer in farmers.values():
        if text in farmer.first_name.lower() or text in farmer.district.lower():
            print(f"  {farmer.farmer_id:<7}{farmer.first_name:<12}{farmer.district}")
            found += 1
    return found


def display_farmers(farmers):
    print(f"\n  ALL FARMERS ({len(farmers)})")
    print("  " + "-" * 60)
    print(f"  {'ID':<7}{'Name':<12}{'District':<14}{'Harvests':>9}{'Total kg':>10}{'Perf.':>7}")
    print("  " + "-" * 60)
    for farmer in farmers.values():
        print(f"  {farmer.farmer_id:<7}{farmer.first_name:<12}{farmer.district:<14}"
              f"{len(farmer.harvests):>9}{farmer.total_harvest_kg():>10}"
              f"{farmer.average_performance():>6}%")


def display_crops(crops):
    print(f"\n  CROP CATALOGUE ({len(crops)} crops)")
    print("  " + "-" * 60)
    for crop in crops.values():
        crop.display_info()


def display_records(records):
    print(f"\n  ALL HARVEST RECORDS ({len(records)})")
