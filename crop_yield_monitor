def main():
    crops, farmers, records = load_sample_data()
    actions = {
        "1": lambda: display_farmers(farmers),
        "2": lambda: display_crops(crops),
        "3": lambda: display_records(records),
        "4": lambda: record_harvest(farmers, crops, records),
        "5": lambda: correct_quantity(records),
        "6": lambda: show_farm_report(farmers),
        "7": lambda: register_farmer(farmers),
        "8": lambda: remove_farmer(farmers, records),
        "9": lambda: search_farmer(farmers),
        "10": lambda: show_top_farmer(farmers),
        "11": lambda: show_crop_statistics(crops, records),
        "12": lambda: show_low_yield_alerts(records),
        "13": lambda: show_summary(farmers, crops, records),
    }
    print("=== Crop Yield Monitoring System (no sensitive personal data stored) ===")
    while True:
        print("\n  MENU")
        number = 0
        for label in MENU:
            number += 1
            print(f"  {number:>2}. {label}")
        print("   0. Exit")
        choice = ask("  Choose an option: ")
        if choice == "0":
            print("  Goodbye!")
            break
        if choice not in actions:
            print("  Problem: please enter one of the numbers shown.")
            continue
        try:
            actions[choice]()
        except ValueError as error:
            print(f"  Problem: {error}")


