def load_sample_data():
    crops = {}
    for entry in CROP_CATALOGUE:
        crop = Crop.from_catalogue(entry)            # class method
        add_record(crops, crop.code, crop)

    farmers = {}
    for farmer in (Farmer("F001", "Aminata", "Bo"),
                   Farmer("F002", "Mohamed", "Kenema"),
                   Farmer.from_string("F003, Fatmata, Bombali"),   # class method
                   Farmer("F004", "Ibrahim", "Port Loko")):
        add_record(farmers, farmer.farmer_id, farmer)

    records = {}
    sample_records = (
        "F001, RICE, 2025, Rainy, 2.0, 5600",
        "F001, GNUT, 2025, Dry, 1.0, 1300",
        "F001, CASS, 2026, Rainy, 1.5, 16500",
        "F002, RICE, 2025, Rainy, 3.0, 4500",
        "F002, MAIZE, 2026, Rainy, 1.0, 1700",
        "F003, CASS, 2025, Rainy, 2.0, 25000",
        "F003, SWPOT, 2026, Dry, 0.5, 3300",
        "F004, MAIZE, 2025, Rainy, 2.0, 2100",
        "F004, RICE, 2026, Rainy, 1.0, 1400",
    )
    for line in sample_records:
        record = HarvestRecord.from_record(line, farmers, crops)   # class method
        add_record(records, record.record_id, record)
    return crops, farmers, records


