def ask(prompt):
    return input(prompt).strip()


def ask_valid(prompt, convert, check, problem):
    """Keep asking until the answer can be converted AND passes the check."""
    while True:
        text = ask(prompt)
        try:
            value = convert(text)
        except ValueError:
            value = None
        if value is not None and check(value):
            return value
        print(f"  Problem: {problem}")


def ask_kg(prompt):
    return ask_valid(prompt, int, lambda kg: kg >= 0,
                     "please type a whole number of kg that is 0 or more, like 3000.")


