def record_harvest(farmers, crops, records):
    farmer = find_record(farmers, ask("  Farmer ID (e.g. F002): "), "farmer")
    print("  Crops: " + ", ".join(f"{code} = {name}" for code, name, _ in CROP_CATALOGUE))
    crop = find_record(crops, ask("  Crop code: "), "crop")
    low, high = AREA_LIMITS
    year = ask_valid("  Harvest year (e.g. 2026): ", int, HarvestRecord.is_valid_year,
                     f"please type a year from 2000 to {date.today().year}.")
    season = ask_valid(f"  Season ({' or '.join(SEASONS)}): ", str, HarvestRecord.is_valid_season,
                       "please type " + " or ".join(SEASONS) + ".")
    area = ask_valid("  Field area in hectares (e.g. 1.5): ", float, HarvestRecord.is_valid_area,
                     f"please type a number from {low} to {high}, like 1.5.")
    kg = ask_kg("  Quantity harvested in kg (e.g. 3000): ")
    record = HarvestRecord(farmer, crop, year, season, area, kg)
    add_record(records, record.record_id, record)
    print(f"  [OK] Saved {record.record_id}: {farmer.first_name}, {crop.name}, "
          f"{record.yield_per_hectare()} t/ha - {record.rating()}")


def correct_quantity(records):
    record = find_record(records, ask("  Harvest record ID (e.g. H005): "), "harvest record")
    record.display_info()
    record.update_quantity(ask_kg("  Correct quantity in kg: "))


def show_farm_report(farmers):
    farmer = find_record(farmers, ask("  Farmer ID (e.g. F001): "), "farmer")
    print()
    farmer.display_farm_report()


def register_farmer(farmers):
    farmer_id = ask("  New farmer ID (e.g. F005): ").upper()
    if not farmer_id:
        raise ValueError("Farmer ID cannot be empty.")
    if farmer_id in farmers:
        raise ValueError(f"ID {farmer_id} already exists.")
    farmer = Farmer(farmer_id, ask("  First name only: "), ask("  District: "))
    add_record(farmers, farmer.farmer_id, farmer)
    print(f"  [OK] Farmer {farmer.farmer_id} registered.")


def remove_farmer(farmers, records):
    farmer = find_record(farmers, ask("  Farmer ID to delete: "), "farmer")
    farmer.display_info()
    if ask("  Type YES to delete this farmer and all their harvests: ").upper() != "YES":
        print("  Cancelled - nothing was deleted.")
        return
    count = len(farmer.harvests)
    delete_farmer(farmers, records, farmer.farmer_id)
    print(f"  [OK] Deleted {farmer.first_name} ({farmer.farmer_id}) and {count} harvest record(s).")


def search_farmer(farmers):
    text = ask("  Type part of a first name or district: ")
    if not text:
        raise ValueError("Please type at least one letter.")
    print(f"\n  SEARCH RESULTS FOR '{text}'")
    print("  " + "-" * 40)
    if search_farmers(farmers, text) == 0:
        print("  No farmers matched your search.")


def show_top_farmer(farmers):
    top = Farmer.find_top_farmer(farmers)      # static method
    print("\n  TOP-PERFORMING FARMER (highest average performance)")
    print("  " + "-" * 52)
    if top is None:
        print("  No harvests have been recorded yet.")
        return
    print(f"  {top.first_name} ({top.farmer_id}), {top.district} district")
    print(f"  Harvests recorded   : {len(top.harvests)}")
    print(f"  Total harvested     : {top.total_harvest_kg()} kg")
    print(f"  Average performance : {top.average_performance()}% of expected yield")


def show_crop_statistics(crops, records):
    print("\n  CROP STATISTICS")
    for crop in crops.values():
        count, total_kg, average, best = crop.get_statistics(records)   # tuple unpacking
        print("  " + "-" * 60)
        print(f"  {crop.name} (expected {crop.expected_yield} t/ha)")
        if count == 0:
            print("    No harvests recorded yet.")
            continue
        print(f"    Harvests: {count}   Total: {total_kg} kg   Average: {average} t/ha")
        print(f"    Best    : {best.yield_per_hectare()} t/ha by {best.farmer.first_name} "
              f"({best.farmer.district}, {best.season} {best.year})")
    print("  " + "-" * 60)


def show_low_yield_alerts(records):
    """Harvests rated Poor - these farms may need a visit from an extension officer."""
    print("\n  LOW-YIELD ALERTS (rated Poor - below 70% of expected)")
    print("  " + "-" * 60)
    found = 0
    for record in records.values():
        if record.rating() == "Poor":
            found += 1
            print(f"  {record.record_id}  {record.farmer.first_name} ({record.farmer.district}): "
                  f"{record.crop.name} {record.yield_per_hectare()} t/ha, "
                  f"{round(record.performance_ratio() * 100)}% of expected")
    if found == 0:
        print("  No low-yield harvests. Well done!")
    else:
        print(f"  {found} harvest(s) need follow-up by an extension officer.")


def show_summary(farmers, crops, records):
    total_kg = 0
    for record in records.values():
        total_kg += record.quantity_kg
    print("\n  SYSTEM SUMMARY")
    print("  " + "-" * 40)
    print(f"  Farmers registered : {Farmer.get_total_farmers()}")
    print(f"  Crops in catalogue : {Crop.get_total_crops()}")
    print(f"  Harvest records    : {HarvestRecord.get_total_records()}")
    print(f"  Total harvested    : {total_kg} kg ({total_kg / 1000:.2f} tonnes)")
    print("\n  YIELD RATINGS (fixed tuple)")
    for minimum, rating in YIELD_RATINGS:
        if minimum > 0:
            print(f"    {rating:<10} at least {round(minimum * 100):>3}% of expected yield")
        else:
            print(f"    {rating:<10} below the bands above")


