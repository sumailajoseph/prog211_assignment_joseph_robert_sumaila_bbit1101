class TestCropYield(unittest.TestCase):
    def setUp(self):
        self.rice = Crop("RICE", "Rice", 2.5)
        self.farmer = Farmer("T001", "Adama", "Bo")

    def test_yield_and_rating(self):
        record = HarvestRecord(self.farmer, self.rice, 2025, "Rainy", 2.0, 5000)
        self.assertEqual(record.yield_per_hectare(), 2.5)
        self.assertEqual(record.rating(), "Good")

    def test_ratings_from_tuple(self):
        self.assertEqual(get_rating(1.3), "Excellent")
        self.assertEqual(get_rating(0.8), "Fair")
        self.assertEqual(get_rating(0.2), "Poor")

    def test_invalid_input_rejected(self):
        with self.assertRaises(ValueError):
            HarvestRecord(self.farmer, self.rice, 2025, "Winter", 1.0, 100)
        with self.assertRaises(ValueError):
            HarvestRecord(self.farmer, self.rice, 2025, "Dry", 0, 100)
        with self.assertRaises(ValueError):
            HarvestRecord(self.farmer, self.rice, 1990, "Dry", 1.0, 100)

    def test_record_registers_with_farmer(self):
        record = HarvestRecord(self.farmer, self.rice, 2025, "dry", 1.0, 2000)
        self.assertIn(record.record_id, self.farmer.harvests)
        self.assertEqual(self.farmer.total_harvest_kg(), 2000)

    def test_update_quantity(self):
        record = HarvestRecord(self.farmer, self.rice, 2025, "Dry", 1.0, 1000)
        record.update_quantity(3000)
        self.assertEqual(record.rating(), "Excellent")

    def test_from_record_class_method(self):
        crops, farmers = {"RICE": self.rice}, {"T001": self.farmer}
        record = HarvestRecord.from_record("T001, rice, 2025, Rainy, 2.0, 6000", farmers, crops)
        self.assertEqual(record.yield_per_hectare(), 3.0)

    def test_crop_statistics_tuple(self):
        a = HarvestRecord(self.farmer, self.rice, 2025, "Dry", 1.0, 2000)
        b = HarvestRecord(self.farmer, self.rice, 2025, "Rainy", 1.0, 3000)
        records = {a.record_id: a, b.record_id: b}
        count, total, average, best = self.rice.get_statistics(records)
        self.assertEqual((count, total, average, best), (2, 5000, 2.5, b))

    def test_top_farmer_and_delete(self):
        other = Farmer("T002", "Sallu", "Kono")
        good = HarvestRecord(self.farmer, self.rice, 2025, "Dry", 1.0, 3000)
        poor = HarvestRecord(other, self.rice, 2025, "Dry", 1.0, 800)
        farmers = {"T001": self.farmer, "T002": other}
        records = {good.record_id: good, poor.record_id: poor}
        self.assertIs(Farmer.find_top_farmer(farmers), self.farmer)
        delete_farmer(farmers, records, "T002")
        self.assertNotIn("T002", farmers)
        self.assertNotIn(poor.record_id, records)

    def test_duplicate_and_missing_ids(self):
        farmers = {}
        add_record(farmers, "T001", self.farmer)
        with self.assertRaises(ValueError):
            add_record(farmers, "T001", self.farmer)
        with self.assertRaises(ValueError):
            find_record(farmers, "T999", "farmer")

    def test_from_string_and_catalogue(self):
        farmer = Farmer.from_string("T003, Musa, Kailahun")
        self.assertEqual((farmer.farmer_id, farmer.district), ("T003", "Kailahun"))
        crop = Crop.from_catalogue(("CASS", "Cassava", 10.0))
        self.assertEqual(crop.expected_yield, 10.0)


